    },
    {
      "avatar": "JP",
      "stars": 5,
      "text": "Trpezlivá profesionálka telom aj dušou — v Trenčíne sa budem pri ďalších nehnuteľnostiach obracať už len na ňu.",
      "author": "Jozef P."
    },
    {
      "avatar": "MV",
